[Unit]
Description=@@DESCRIPTION@@
@@UNIT_DIRECTIVES@@
StartLimitIntervalSec=0

[Service]
Type=simple
@@ACCOUNT@@
@@SERVICE_DIRECTIVES@@
Restart=always
RestartMode=direct
RestartSec=5
RestartSteps=5
RestartMaxDelaySec=60
TimeoutStartSec=150
TimeoutStopSec=90
KillMode=mixed
KillSignal=SIGTERM
SuccessExitStatus=143 SIGTERM
UMask=0077
LimitNOFILE=@@LIMIT_NOFILE@@
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
@@SANDBOX_DIRECTIVES@@

[Install]
WantedBy=@@WANTED_BY@@
