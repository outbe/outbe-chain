+                .read(&id)
+                .unwrap(),
+            0
+        );
+    });
+    cast(&mut provider, id, A, true).unwrap();
+    assert!(cast(&mut provider, id, A, true).is_err());
+    cast(&mut provider, id, B, true).unwrap();
