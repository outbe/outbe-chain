168:     where
169:         A: for<'de> Deserialize<'de>,
170:     {
171:         let manifest = Op::<A>::manifest_of(self.walk.repo, &entry)
172:             .map_err(|err| error::Ops::Manifest { source: err })?;
173:         if manifest.type_name == self.typename {
174:             let op =
175:                 Op::load(self.walk.repo, entry).map_err(|err| error::Ops::Load { source: err })?;
176:             Ok(Some(op))
177:         } else {
178:             Ok(None)
179:         }
180:     }
181: }

