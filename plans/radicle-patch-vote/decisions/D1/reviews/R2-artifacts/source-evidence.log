189:     pub(crate) fn authorize(&self, request: EntryRequest) -> Result<EntryAuthorization, Error> {
190:         if request.authority.as_ed25519().is_some() {
191:             return Ok(EntryAuthorization::native(request));
192:         }
193:         let provider = self
194:             .providers
195:             .read()
196:             .map_err(|_| Error::Unavailable)?
197:             .get(&request.repository)
198:             .cloned();
199:         let Some(record) = self.record(request.repository)? else {
200:             return if provider.is_some() {
201:                 Err(Error::Configuration)
202:             } else {
203:                 Ok(EntryAuthorization::native(request))
204:             };
205:         };
206:         if record.owner != request.authority {
207:             return Ok(EntryAuthorization::native(request));
208:         }
209:         let provider = provider.ok_or(Error::Unavailable)?;
210:         if provider.id() != record.policy {
211:             return Err(Error::Configuration);
212:         }
213:         let authorization = provider.authorize_entry(&request)?;
214:         if authorization.request != request
215:             || authorization.context == [0; 32]
216:             || authorization.receipt.is_none()
217:         {
218:             return Err(Error::InvalidAuthorization);
219:         }
220:         Ok(authorization)
221:     }
222: }

