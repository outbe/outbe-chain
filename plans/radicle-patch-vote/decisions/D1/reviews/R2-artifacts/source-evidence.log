824: impl<R, S> ValidateRepository for Cached<'_, R, S>
825: where
826:     R: AsRef<Repository>,
827: {
828:     // N.b. we don't verify the `rad/id` of each remote since they may
829:     // not have a reference to the COB if they have not interacted
830:     // with it.
831:     fn validate_remote(&self, remote: &Remote) -> Result<Validations, storage::Error> {
832:         // Contains a copy of the signed refs of this remote.
833:         let mut signed = BTreeMap::from((*remote.refs).clone());
834:         let mut validations = Validations::default();
835:         let mut has_sigrefs = false;
836: 
837:         // Check all repository references, making sure they are present in the signed refs map.
838:         for (refname, oid) in self.state.refs.references_of(&remote.id()) {
839:             // Skip validation of the signed refs branch, as it is not part of `Remote`.
840:             if refname == storage::refs::SIGREFS_BRANCH.to_ref_string() {
841:                 has_sigrefs = true;
842:                 continue;
843:             }
844:             if let Some(signed_oid) = signed.remove(&refname) {
845:                 if oid != signed_oid {
846:                     validations.push(Validation::MismatchedRef {
847:                         remote: remote.id(),
848:                         refname,
849:                         expected: signed_oid,
850:                         actual: oid,
851:                     });
852:                 }
853:             } else {
854:                 validations.push(Validation::UnsignedRef(refname));
855:             }
856:         }
857: 
858:         if !has_sigrefs {
859:             validations.push(Validation::MissingRadSigRefs(remote.id()));
860:         }
861: 
