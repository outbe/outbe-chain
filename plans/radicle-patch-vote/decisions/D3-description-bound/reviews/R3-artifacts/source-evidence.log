69:     pub fn from_bytes(bytes: &[u8]) -> Result<Self> {
70:         if bytes.len() > MAX_GOVERNMENTS_DESCRIPTOR_BYTES {
71:             return Err(PrecompileError::revert("oversized governments descriptor"));
72:         }
73:         let mut input = bytes;
74:         if take::<4>(&mut input)? != *b"OGD1" || take::<2>(&mut input)? != 1_u16.to_be_bytes() {
75:             return Err(PrecompileError::revert(
76:                 "unsupported governments descriptor",
77:             ));
78:         }
79:         let chain_id = u64::from_be_bytes(take(&mut input)?);
80:         let genesis_timestamp = u64::from_be_bytes(take(&mut input)?);
81:         if take::<2>(&mut input)? != 11_u16.to_be_bytes()
82:             || take::<11>(&mut input)? != *b"governments"
83:             || take::<2>(&mut input)? != 4_u16.to_be_bytes()
84:             || take::<4>(&mut input)? != *b"main"
85:         {
86:             return Err(PrecompileError::revert(
87:                 "governments descriptor requires governments/main",
88:             ));
89:         }
90:         let length = usize::from(u16::from_be_bytes(take(&mut input)?));
91:         if length > MAX_GOVERNMENTS_DESCRIPTION_BYTES {
92:             return Err(PrecompileError::revert("oversized governments description"));
93:         }
94:         let (description, tail) = input
95:             .split_at_checked(length)
96:             .ok_or_else(|| PrecompileError::revert("truncated governments description"))?;
97:         let description = String::from_utf8(description.to_vec())
98:             .map_err(|_| PrecompileError::revert("governments description is not UTF-8"))?;
120:     /// The optional genesis field contains the exact pre-genesis OGD1 artifact as hex.
121:     pub fn from_genesis_field(
122:         value: Option<&serde_json::Value>,
123:         chain_id: u64,
124:         genesis_timestamp: u64,
125:         seeded_hash: B256,
126:     ) -> Result<Option<Self>> {
127:         let Some(value) = value else {
128:             return if seeded_hash.is_zero() {
129:                 Ok(None)
130:             } else {
131:                 Err(PrecompileError::revert(
132:                     "seeded governments descriptor is missing from genesis config",
133:                 ))
134:             };
135:         };
136:         let text = value
137:             .as_str()
138:             .and_then(|text| text.strip_prefix("0x"))
139:             .filter(|text| text.len() <= MAX_GOVERNMENTS_DESCRIPTOR_BYTES * 2)
140:             .ok_or_else(|| {
141:                 PrecompileError::revert("radicleGovernments must be a bounded hex OGD1 descriptor")
142:             })?;
143:         let bytes = hex::decode(text)
144:             .map_err(|_| PrecompileError::revert("invalid governments descriptor hex"))?;
145:         let descriptor = Self::from_bytes(&bytes)?;
146:         descriptor.validate(chain_id, genesis_timestamp)?;
