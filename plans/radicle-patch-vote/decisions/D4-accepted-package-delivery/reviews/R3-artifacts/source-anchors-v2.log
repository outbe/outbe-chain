21: pub(super) async fn preflight(
22:     args: &ConsensusArgs,
23: ) -> eyre::Result<(
24:     Option<Preflight>,
25:     outbe_radicle::integration::RadicleStatusHandle,
26: )> {
27:     let (radicle_preflight, radicle_status) = if args.is_validator {
28:         let socket = args
29:             .radicle_control_socket
30:             .as_ref()
31:             .expect("validated Radicle control socket");
32:         let sidecar =
33:             outbe_radicle::integration::query_sidecar(socket, std::time::Duration::from_secs(5))
34:                 .await
35:                 .wrap_err("Radicle sidecar preflight failed")?;
36:         let evm_key = args
37:             .effective_validator_evm_key()?
38:             .ok_or(LaunchError::MissingValidatorEvmKeyForRadicle)?;
39:         let validator = outbe_primitives::signer::load::from_file(&evm_key)
40:             .wrap_err("load validator EVM key for Radicle identity")?
41:             .address();
42:         let (publisher, status) =
43:             outbe_radicle::integration::RadicleStatusChannel::enabled(validator, sidecar.node_id);
44:         (Some((validator, sidecar, publisher)), status)
45:     } else {
46:         (
47:             None,
48:             outbe_radicle::integration::RadicleStatusChannel::disabled(),
49:         )
50:     };
51:     if radicle_preflight.is_none() {
52:         let mut metrics = outbe_radicle::integration::RadicleMetrics::default();
53:         metrics.record(&radicle_status.snapshot());
54:     }
55:     Ok((radicle_preflight, radicle_status))
56: }
