114:     fn gossip_material(&self) -> Result<signing::RepositorySigningMaterial, signing::Error> {
115:         let authority = self
116:             .repository_authority
117:             .as_ref()
118:             .ok_or(signing::Error::Unavailable)?
119:             .read_current_repository_authority()?;
120:         if authority.chain_id() != self.chain.chain_id
121:             || authority.genesis_hash() != self.chain.genesis_hash
122:         {
123:             return Err(signing::Error::Material);
124:         }
125:         let owner = radicle::crypto::BlsPublicKey::from_bytes(
126:             authority
127:                 .committee()
128:                 .vrf_group_public_key_bytes
129:                 .as_slice()
130:                 .try_into()
131:                 .map_err(|_| signing::Error::Material)?,
132:         )?;
133:         self.repository_material.current(authority, owner)
134:     }
