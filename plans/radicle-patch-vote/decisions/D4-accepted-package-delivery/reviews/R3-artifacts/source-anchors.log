592:     pub fn load_selected(
593:         &self,
594:         slot: B256,
595:         repo: &Repository,
596:     ) -> Result<Option<StoredReviewPackage>, Error> {
597:         let Some((body, witness)) = self.selection(slot)? else {
598:             return Ok(None);
599:         };
600:         self.load(body, witness, repo).map(Some)
601:     }
602: 
603:     fn load(
604:         &self,
605:         body_hash: B256,
606:         witness_hash: B256,
607:         repo: &Repository,
608:     ) -> Result<StoredReviewPackage, Error> {
609:         let directory = self.package_dir(body_hash);
610:         if read(
611:             &directory.join("ready").join(hex::encode(witness_hash)),
612:             READY.len(),
613:         )? != READY
614:         {
615:             return Err(Error::Corrupt);
616:         }
617:         let body =
618:             PublicationBody::from_bytes(&read(&directory.join("body"), PUBLICATION_BODY_LEN)?)
619:                 .map_err(|_| Error::Corrupt)?;
620:         if body.receipt_hash() != body_hash {
621:             return Err(Error::Corrupt);
622:         }
623:         let manifest = PublicationManifest::from_bytes(&read(
624:             &directory.join("manifest"),
625:             MAX_MANIFEST_BYTES,
626:         )?)?;
627:         if manifest.hash()? != body.package_manifest_hash {
628:             return Err(Error::Corrupt);
629:         }
630:         let bytes = read(
631:             &directory.join("witnesses").join(hex::encode(witness_hash)),
632:             MAX_WITNESS_BYTES,
633:         )?;
634:         if B256::from(Sha256::hash(&[&bytes]).0) != witness_hash {
635:             return Err(Error::Corrupt);
636:         }
637:         let witness = RepositoryWitnessBundle::from_bytes(&bytes)?;
638:         let odb = repo.raw().odb()?;
639:         for row in manifest.objects() {
640:             let bytes = read(
641:                 &directory.join("objects").join(&row.sha256),
642:                 MAX_OBJECT_BYTES,
643:             )?;
644:             let oid: git::Oid = row.oid.parse().map_err(|_| Error::Corrupt)?;
645:             let kind = object_type(row.kind);
646:             if hex::encode(Sha256::hash(&[&bytes]).0) != row.sha256
647:                 || git::raw::Oid::hash_object(kind, &bytes)? != oid.into()
648:             {
649:                 return Err(Error::Corrupt);
650:             }
651:             if odb.write(kind, &bytes)? != oid.into() {
652:                 return Err(Error::Corrupt);
653:             }
654:         }
655:         Ok(StoredReviewPackage {
656:             body,
657:             manifest,
658:             witness,
659:         })
660:     }
