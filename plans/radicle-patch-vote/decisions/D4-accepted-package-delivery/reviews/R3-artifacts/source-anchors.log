562:     async fn install(
563:         &mut self,
564:         client: &LocalReceiptClient,
565:         receipt: FinalizedPublicationReceipt,
566:     ) -> Result<Outcome> {
567:         if self.snapshot.is_some() {
568:             return Ok(Outcome::Announced);
569:         }
570:         let id = git::Oid::from_sha1(receipt.receipt().body.repo_id.0).into();
571:         let owner = RepositoryKey::from(BlsPublicKey::from_bytes(
572:             receipt.receipt().body.owner_bls_public.0,
573:         )?);
574:         let policy = match &self.policy {
575:             Some((repository, policy)) if *repository == id => policy.clone(),
576:             Some(_) => return Err("accepted bootstrap repository changed".into()),
577:             None => Arc::new(AcceptedRepositoryPolicy::pending_receipt(&receipt)?),
578:         };
579:         self.storage.manage_repository(id, owner, policy.clone())?;
580:         self.policy = Some((id, policy.clone()));
581:         let repo = self.repository(id)?;
582:         let Some(package) = self
583:             .journal
584:             .packages
585:             .load_selected(review_slot_key(&receipt.receipt().body), &repo)?
586:         else {
587:             return Ok(Outcome::AwaitingAcceptedPackage);
588:         };
589:         if package.body != receipt.receipt().body {
590:             return Err("accepted bootstrap differs from persisted selection".into());
591:         }
592:         let (descriptor, content) = self.journal.packages.load_bootstrap_inputs(&receipt)?;
593:         let verifier = AcceptedPublicationVerifier::from_receipt(
594:             receipt.clone(),
595:             package.manifest.clone(),
596:             package.witness.public_output(),
597:         )?;
598:         let proof = bootstrap::verify_accepted_bootstrap(
599:             &repo,
600:             &descriptor,
601:             &content,
602:             &verifier,
603:             &package.witness,
604:         )?;
605:         let snapshot = CheckpointOwnerSnapshot::bootstrap(receipt.clone(), &package.manifest)?;
606:         policy.accept_bootstrap(&proof)?;
607:         client
608:             .cache_checkpoint_manifest(&receipt, &package.manifest)
609:             .await?;
610:         self.snapshot = Some(snapshot);
611:         if client.read(2).await?.is_some() {
612:             return Ok(Outcome::CatchingUp);
613:         }
614:         proof.install(&repo)?;
615:         put(
616:             &self.journal.root.join("installed"),
617:             receipt.receipt().receipt_hash.as_slice(),
618:             false,
619:         )?;
620:         self.handle.seed(id, radicle::node::policy::Scope::All)?;
621:         self.handle.add_inventory(id)?;
622:         self.handle.announce_refs_for(id, [owner])?;
623:         self.handle.announce_inventory()?;
624:         put(
625:             &self.journal.root.join("announced"),
626:             receipt.receipt().receipt_hash.as_slice(),
627:             false,
628:         )?;
629:         self.announced = Some(receipt.receipt().receipt_hash.0);
630:         Ok(Outcome::Announced)
631:     }
632: }
