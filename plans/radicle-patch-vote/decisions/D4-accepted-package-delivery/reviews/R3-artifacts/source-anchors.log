340:     async fn sync_accepted_reviews(
341:         &mut self,
342:         client: &LocalReceiptClient,
343:     ) -> Result<Option<Outcome>> {
344:         for _ in 0..32 {
345:             let snapshot = self
346:                 .snapshot
347:                 .as_ref()
348:                 .ok_or("accepted snapshot missing")?
349:                 .clone();
350:             let next = snapshot
351:                 .checkpoint()
352:                 .receipt()
353:                 .body
354:                 .sequence
355:                 .checked_add(1)
356:                 .ok_or("publication sequence overflow")?;
357:             let Some(receipt) = client.read(next).await? else {
358:                 self.promote_snapshot(&snapshot)?;
359:                 return Ok(None);
360:             };
361:             let repo =
362:                 self.repository(git::Oid::from_sha1(receipt.receipt().body.repo_id.0).into())?;
363:             let Some(package) = self
364:                 .journal
365:                 .packages
366:                 .load_selected(review_slot_key(&receipt.receipt().body), &repo)?
367:             else {
368:                 return Ok(Some(Outcome::AwaitingAcceptedPackage));
369:             };
370:             if package.body != receipt.receipt().body {
371:                 return Err("accepted Review selection differs".into());
372:             }
373:             let approval = if package.body.action
374:                 == outbe_primitives::radicle_publication::PublicationAction::BindMaterial
375:             {
376:                 None
377:             } else {
378:                 Some(
379:                     client
380:                         .read_patch_approval(package.body.proposal_id)
381:                         .await?
382:                         .ok_or("accepted patch approval missing")?,
383:                 )
384:             };
385:             let verifier = AcceptedPublicationVerifier::from_receipt(
386:                 receipt.clone(),
387:                 package.manifest.clone(),
388:                 package.witness.public_output(),
389:             )?;
390:             let policy = &self.policy.as_ref().ok_or("accepted policy missing")?.1;
391:             match package.body.action {
392:                 outbe_primitives::radicle_publication::PublicationAction::Review => {
393:                     let proof = verify_accepted_review_publication(
394:                         &repo,
395:                         approval.as_ref().ok_or("patch approval missing")?,
396:                         &snapshot,
397:                         &verifier,
398:                         &package.witness,
399:                     )?;
400:                     policy.accept_review(&proof)?;
401:                 }
402:                 outbe_primitives::radicle_publication::PublicationAction::Merge => {
403:                     let review = self
404:                         .accepted_review(
405:                             client,
406:                             &repo,
407:                             package.body.proposal_id,
408:                             snapshot.checkpoint().receipt().body.sequence,
409:                         )
410:                         .await?;
411:                     let proof = outbe_radicle::integration::publication::merge::verify_accepted_merge_publication(&repo, approval.as_ref().ok_or("patch approval missing")?, &snapshot, &review, &verifier, &package.witness)?;
412:                     policy.accept_merge(&proof)?;
413:                 }
414:                 outbe_primitives::radicle_publication::PublicationAction::BindMaterial => {
415:                     let proof = outbe_radicle::integration::publication::binding::verify_accepted_material_publication(&snapshot, &verifier, &package.witness)?;
416:                     policy.accept_material(&proof)?;
417:                 }
418:                 _ => return Err("unsupported accepted patch action".into()),
419:             }
420:             let mut snapshot = snapshot;
421:             snapshot.advance(receipt.clone(), &package.manifest)?;
422:             client
423:                 .cache_checkpoint_manifest(&receipt, &package.manifest)
424:                 .await?;
425:             self.snapshot = Some(snapshot);
426:         }

