153: pub(crate) fn prepare_patch_review_with_objects(
154:     repo: &Repository,
155:     approval: &FinalizedPatchApproval,
156:     snapshot: &CheckpointOwnerSnapshot,
157:     context: &ReviewSigningContext,
158: ) -> Result<(CheckpointPreparedReview, BTreeSet<git::Oid>), Error> {
159:     let receipt = snapshot.checkpoint().receipt();
160:     let body = &receipt.body;
161:     if context.chain_id != body.chain_id
162:         || context.genesis_hash != body.genesis_hash.0
163:         || context.epoch != body.epoch
164:         || context.material_version != body.material_version
165:         || context.material_hash != body.material_hash.0
166:         || context.previous_receipt_hash != receipt.receipt_hash.0
167:         || repo.id().into_sha1() != Some(body.repo_id.0)
168:     {
169:         return Err(Error::Snapshot);
170:     }
171:     let identity = snapshot
172:         .owner_refs()
173:         .get(&radicle::storage::refs::IDENTITY_ROOT)
174:         .ok_or(Error::Snapshot)?;
175:     let owner: RepositoryKey =
176:         radicle::crypto::BlsPublicKey::from_bytes(body.owner_bls_public.0)?.into();
177:     let decision = PatchVotePayloadV1::decode(approval.approval.payload.as_bytes())
178:         .map_err(|_| Error::Approval)?;
179:     let patch: patch::PatchId = git::Oid::from_sha1(decision.patch_id.0).into();
180:     let name =
181:         git::refs::storage::cob(&owner, &patch::TYPENAME, &patch).strip_namespace_recursive();
182:     let previous = snapshot.owner_refs().get(&name);
183:     let review = prepare_patch_review(repo, approval, identity, previous, context)?;
184:     if review.owner() != owner {
185:         return Err(Error::Authority);
186:     }
187:     let mut roots: Vec<_> = snapshot.owner_refs().iter().map(|(_, oid)| *oid).collect();
188:     roots.push(snapshot.sigrefs());
189:     roots.extend_from_slice(&review.dependencies);
190:     let objects = object_closure(repo.raw(), roots, true)?;
191:     Ok((
192:         CheckpointPreparedReview {
193:             review,
194:             snapshot: snapshot.clone(),
195:             approval: approval.approval.clone(),
196:         },
197:         objects,
198:     ))
199: }
389:         || doc.threshold() != 1
390:         || doc.default_branch().map_err(|_| Error::Authority)?.as_str() != "refs/heads/main"
391:     {
392:         return Err(Error::Authority);
393:     }
394:     let patch: patch::PatchId = git::Oid::from_sha1(decision.patch_id.0).into();
395:     let revision: patch::RevisionId = git::Oid::from_sha1(decision.revision_id.0).into();
396:     let mut tips = vec![merge.map_or(*revision, |(review, _)| review)];
397:     tips.extend(previous_owner_tip);
398:     tips.sort_unstable();
399:     tips.dedup();
400:     let name = git::refs::storage::cob(&owner, &patch::TYPENAME, &patch);
401:     let pinned = object::Objects::from(
402:         tips.iter()
403:             .map(|id| object::Reference {
404:                 name: name.to_ref_string(),
405:                 target: object::Commit { id: *id },
406:             })
407:             .collect::<Vec<_>>(),
408:     );
409:     let object = cob::get_at::<patch::Patch, _>(repo, &patch::TYPENAME, &patch, &pinned)?
410:         .ok_or(Error::Revision)?;
411:     // The evaluator can prune invalid branches; every pinned tip must survive evaluation.
412:     if tips.iter().any(|tip| !object.history.graph().contains(tip))
413:         || object.object.revision(&revision).is_none()
414:     {
415:         return Err(Error::Revision);
416:     }
417:     match object.object.target() {
418:         patch::MergeTarget::Delegates => (),
419:         patch::MergeTarget::Branch(branch) if branch.as_str() == "refs/heads/main" => (),
420:         _ => return Err(Error::Target),
421:     }
422:     let revision_state = object.object.revision(&revision).ok_or(Error::Revision)?;
423:     if merge.is_some()
424:         && revision_state.review_by(&owner).and_then(|r| r.verdict())
425:             != Some(patch::Verdict::Accept)
426:     {
427:         return Err(Error::Revision);
428:     }
429:     let content = [
430:         *revision_state.base(),
431:         revision_state.head(),
432:         git::Oid::from_sha1(decision.expected_target_head.0),
433:     ];
434:     for id in content {
435:         repo.raw().find_commit(id.into())?;
436:     }
437:     let mut dependencies = tips.clone();
438:     dependencies.push(identity);
439:     dependencies.extend(content);
440:     if let Some((_, result)) = merge {
441:         dependencies.push(result);
442:     }
443:     dependencies.sort_unstable();
444:     dependencies.dedup();
490: pub(crate) fn object_closure(
491:     repo: &git::raw::Repository,
492:     mut pending: Vec<git::Oid>,
493:     parents: bool,
494: ) -> Result<BTreeSet<git::Oid>, Error> {
495:     let mut seen = BTreeSet::new();
496:     let odb = repo.odb()?;
497:     while let Some(id) = pending.pop() {
498:         if !seen.insert(id) {
499:             continue;
500:         }
501:         let object = odb.read(id.into())?;
502:         if git::raw::Oid::hash_object(object.kind(), object.data())? != id.into() {
503:             return Err(Error::Object);
504:         }
505:         match object.kind() {
506:             git::raw::ObjectType::Commit => {
507:                 let commit = repo.find_commit(id.into())?;
508:                 pending.push(commit.tree_id().into());
509:                 if parents {
510:                     pending.extend(commit.parent_ids().map(git::Oid::from));
511:                 }
512:             }
513:             git::raw::ObjectType::Tree => {
514:                 for entry in repo.find_tree(id.into())?.iter() {
515:                     match entry.kind() {
516:                         Some(git::raw::ObjectType::Blob | git::raw::ObjectType::Tree) => {
517:                             pending.push(entry.id().into())
518:                         }
519:                         Some(git::raw::ObjectType::Commit) if entry.filemode() == 0o160000 => (),
520:                         _ => return Err(Error::Object),
521:                     }
522:                 }
523:             }
524:             git::raw::ObjectType::Blob => (),
525:             _ => return Err(Error::Object),
526:         }
527:     }
528:     Ok(seen)
529: }

