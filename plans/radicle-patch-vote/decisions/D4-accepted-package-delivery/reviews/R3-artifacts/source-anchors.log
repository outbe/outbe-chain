136:     pub(super) fn receive_gossip(
137:         &mut self,
138:         sender: bls12381::PublicKey,
139:         bytes: &[u8],
140:     ) -> Result<(), signing::Error> {
141:         let message = RepositoryGossipMessage::from_bytes(bytes)?;
142:         let material = self.gossip_material()?;
143:         message.verify_sender(&material, &sender)?;
144:         self.sync_gossip_material(&material);
145:         // At most Doc/COB/refs + one attestation per authenticated current participant.
146:         self.repository_inbox
147:             .insert((PeerId::from_public_key(&sender), message.slot()), message);
148:         Ok(())
149:     }
150: 
151:     pub(super) fn drain_gossip(
152:         &mut self,
153:     ) -> Result<Vec<ReceivedRepositoryMessage>, signing::Error> {
154:         let material = match self.gossip_material() {
155:             Ok(material) => material,
156:             Err(error) => {
157:                 self.repository_inbox.clear();
158:                 self.repository_inbox_material = None;
159:                 return Err(error);
160:             }
161:         };
162:         self.sync_gossip_material(&material);
163:         std::mem::take(&mut self.repository_inbox)
164:             .into_iter()
165:             .map(|((peer, _), message)| {
166:                 Ok(ReceivedRepositoryMessage {
167:                     sender: peer
168:                         .to_public_key()
169:                         .map_err(|_| signing::Error::Participant)?,
170:                     message,
171:                 })
172:             })
173:             .collect()
174:     }
180:         }
181:     }
182: 
183:     pub(super) fn gossip<S>(
184:         &self,
185:         sender: &mut S,
186:         identity: &bls12381::PrivateKey,
187:         message: &RepositoryGossipMessage,
188:     ) -> Result<usize, signing::Error>
189:     where
190:         S: LimitedSender<PublicKey = bls12381::PublicKey>,
191:     {
192:         let material = self.gossip_material()?;
193:         message.verify_sender(&material, &identity.public_key())?;
194:         let bytes = message.to_bytes()?;
195:         let own = PeerId::from_public_key(&identity.public_key());
196:         Ok(material
197:             .authority()
198:             .committee()
199:             .committee
200:             .iter()
201:             .filter(|member| {
202:                 let Ok(key) = bls12381::PublicKey::decode(member.consensus_pubkey.as_slice())
203:                 else {
204:                     return false;
205:                 };
206:                 let peer = PeerId::from_public_key(&key);
207:                 peer != own && send(sender, peer, bytes.clone())
208:             })
209:             .count())
210:     }
211: }
