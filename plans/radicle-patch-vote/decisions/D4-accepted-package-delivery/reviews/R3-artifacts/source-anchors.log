331:     fn persist(
332:         &mut self,
333:         repo: &Repository,
334:         body: &PublicationBody,
335:         manifest: &PublicationManifest,
336:         expected_witness_hash: B256,
337:         witness: &RepositoryWitnessBundle,
338:         bootstrap: Option<(&GovernmentsDescriptor, &[u8])>,
339:     ) -> Result<(), Error> {
340:         let body_hash = body.receipt_hash();
341:         let witness_bytes = witness.to_bytes()?;
342:         let witness_hash: B256 = Sha256::hash(&[&witness_bytes]).0.into();
343:         if witness_hash != expected_witness_hash {
344:             return Err(Error::Corrupt);
345:         }
346:         let slot = review_slot_key(body);
347:         if let Some((body, witness)) = self.selection(slot)? {
348:             if body != body_hash {
349:                 return Err(Error::SlotConflict);
350:             }
351:             // The durable pointer keeps its original witness even if a new valid subset arrives.
352:             self.load(body, witness, repo)?;
353:         }
354:         let directory = self.package_dir(body_hash);
355:         private_dir(&directory)?;
356:         for child in ["objects", "witnesses", "ready"] {
357:             private_dir(&directory.join(child))?;
358:         }
359:         write_once(&directory.join("body"), &body.to_bytes())?;
360:         write_once(&directory.join("manifest"), &manifest.to_bytes()?)?;
361:         if let Some((descriptor, content)) = bootstrap {
362:             validate_bootstrap_inputs(body, descriptor, content)?;
363:             write_once(
364:                 &directory.join("descriptor"),
365:                 &descriptor.to_bytes().map_err(|_| Error::Corrupt)?,
366:             )?;
367:             write_once(&directory.join("initial-content.manifest"), content)?;
368:         }
369:         let odb = repo.raw().odb()?;
370:         for row in manifest.objects() {
371:             let oid: git::Oid = row.oid.parse().map_err(|_| Error::Corrupt)?;
372:             let (size, kind) = odb.read_header(oid.into())?;
373:             if size > MAX_OBJECT_BYTES || kind != object_type(row.kind) {
374:                 return Err(Error::Corrupt);
375:             }
376:             let object = odb.read(oid.into())?;
377:             if object.kind() != object_type(row.kind)
378:                 || object.data().len() > MAX_OBJECT_BYTES
379:                 || hex::encode(Sha256::hash(&[object.data()]).0) != row.sha256
380:                 || git::raw::Oid::hash_object(object.kind(), object.data())? != oid.into()
381:             {
382:                 return Err(Error::Corrupt);
383:             }
384:             write_once(&directory.join("objects").join(&row.sha256), object.data())?;
385:         }
386:         write_once(
387:             &directory.join("witnesses").join(hex::encode(witness_hash)),
388:             &witness_bytes,
389:         )?;
390:         write_once(
391:             &directory.join("ready").join(hex::encode(witness_hash)),
392:             READY,
393:         )?;
394:         self.select(slot, body_hash, witness_hash)?;
395:         Ok(())
396:     }
