[Unit]
Description=Outbe validator price feeder
After=outbe-validator.service
Wants=outbe-validator.service
PartOf=outbe-validator.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=outbe
Group=outbe
EnvironmentFile=/opt/outbe-chain/validator.env
RuntimeDirectory=outbe-feeder
RuntimeDirectoryMode=0700
StateDirectory=outbe-feeder
StateDirectoryMode=0700
ExecStartPre=@OUTBE_UP@ internal wait-rpc
ExecStart=@OUTBE_UP@ internal feeder
Restart=always
RestartMode=direct
RestartSec=5
RestartSteps=5
RestartMaxDelaySec=60
TimeoutStartSec=150
TimeoutStopSec=60
KillSignal=SIGTERM
UMask=0077
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=outbe-validator.target
