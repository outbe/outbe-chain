# OCOMP-owned finalized receipt projection. These credentials are only passed
# to the snapshot-exporter process.
OUTBE_OCOMP_PROJECTION_MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
# Must differ from the node's OUTBE_PROJECTION_MONGODB_DATABASE.
OUTBE_OCOMP_PROJECTION_MONGODB_DATABASE=outbe_ocomp_validator_<0-3>
