# Same network identity on all four validators.
OCOMP_CHAIN_ID=54322345
OCOMP_GENESIS_HASH=0x4867c0fdb7c2f9be64ccf1b28c3ce3d72fba122848562562d026e5e6cd1ef8ea
OCOMP_PROTOCOL_BUNDLE_HASH=0x6bfde0fdd455e63ec78857161e70b15500a6f29b7da6bdf96487fbf829fd34fd

# Per-host OCOMP process identity.
OCOMP_BOOT_NONCE=0xd655af601532978aba762dd5fe3911643db6aa6a22ecc554ddd10b8b4d6d114f
OCOMP_REGISTRY_GENERATION=1
OCOMP_VALIDATOR_INDEX=0
OCOMP_SUPERVISOR_ADDRESS=127.0.0.1:9765
OCOMP_WORKER_COUNT=4

# Per-host values.
OUTBE_OCOMP_BASE_PATH=/opt/outbe-chain
OUTBE_OCOMP_RPC_URL=http://127.0.0.1:8545

# `ocomp.sh install` creates the dedicated OCOMP EVM key at:
#   $OUTBE_OCOMP_BASE_PATH/ocomp/data/keys/ocomp-evm-key.hex
# Delegate the address printed by `outbe-ocomp signer-address` with:
#   outbe-cli validator delegate ocomp <address>
