# Env of the deploy scripts. Order: DeployOrigin and DeployTarget, then ConfigureOrigin and
# ConfigureTarget, then HandOver.

# [required] Deployer private key. The deployer fixes every CREATE3 address.
DEPLOYER_PK=
# [required] CREATE3 factory, deployed once from contracts/shared (mise run deploy-create3-factory there)
CREATE3_FACTORY_ADDRESS=
# [optional] CREATE3 salt; empty selects the pinned production one
CONTRACT_SALT=

# [required] Deploy*: the ERC-7786 hub (crosschain ERC7786Bridge)
BRIDGE_ADDRESS=
# [required] Deploy*: auction target chain ids, csv; Outbe is one of them as a loopback target
TARGET_CHAIN_IDS=
# [required] DeployTarget: the chain id of the OriginRouter (Outbe)
ORIGIN_CHAIN_ID=
# [optional] DeployOrigin: wCOEN token and bridge on Outbe, for the proceeds route
OUTBE_WCOEN_TOKEN=
OUTBE_WCOEN_BRIDGE=
# [optional] DeployTarget: wCOEN bridge on this chain, for the proceeds route
WCOEN_BRIDGE=

# [required] ConfigureOrigin: the Outbe precompiles and the system caller
DESIS_ADDRESS=0x0000000000000000000000000000000000001016
INTEX_FACTORY_ADDRESS=0x0000000000000000000000000000000000001015
GEM_FACTORY_ADDRESS=0x0000000000000000000000000000000000002013
OUTBE_SYSTEM_TX_ADDRESS=0xff00000000000000000000000000000000000001
# [required] ConfigureTarget: The Compact and the wCOEN token on this chain
COMPACT_ADDRESS=0x00000000000000171ede64904551eeDF3C6C9788
WCOEN_TOKEN=

# [required] HandOver: Outbe chain id, and on another chain the Outbe RPC for the governance account
OUTBE_CHAIN_ID=
OUTBE_RPC_URL=https://rpc.testnet.outbe.net
