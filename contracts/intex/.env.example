# Env of the deploy scripts. Order: DeployAll on every chain, Outbe included, then 6_HandOver.
# Hyperlane must know the chain first: DeployAll reads the Interchain Account of Outbe there.

# [required] Network: an rpc_endpoints alias of foundry.toml or an RPC URL
NETWORK=outbe-testnet
# [required] Deployer private key. The deployer fixes every CREATE3 address.
DEPLOYER_PK=
# [required] CREATE3 factory, deployed once from contracts/shared (mise run deploy-create3-factory there)
CREATE3_FACTORY_ADDRESS=
# [optional] CREATE3 salt; empty selects the pinned production one
CONTRACT_SALT=

# [required] The chain id of Outbe, and the Outbe RPC for the Interchain Account of Outbe
OUTBE_CHAIN_ID=54322345
OUTBE_RPC_URL=https://rpc.testnet.outbe.net

# [required] DeployAll: the ERC-7786 hub (crosschain ERC7786Bridge)
BRIDGE_ADDRESS=
# [required] DeployAll: chain ids whose IntexNFT1155Router this one pairs with, csv; this chain is skipped
REMOTE_CHAIN_IDS=
# [required] DeployAll: the WCOEN token bridge, the same CREATE3 address on every chain
WCOEN_BRIDGE=
# [required] DeployAll: The Compact and the WCOEN token on this chain
COMPACT_ADDRESS=0x00000000000000171ede64904551eeDF3C6C9788
WCOEN_TOKEN=

# PrepareUpgrade (mise run prepare-upgrade): any funded key that sends the new implementations
PRIVATE_KEY=
# [optional] The deployer of the stack; unset: the address of PRIVATE_KEY
# DEPLOYER_ADDRESS=
# [optional] Every chain of the stack, csv of rpc_endpoints aliases or URLs; unset: NETWORK only
# RPC_URLS=
# [required for a vote] The commit the implementations are built from, and the blocks between the approval and the upgrade (at least 50)
SOURCE_COMMIT=
EXECUTION_DELAY_BLOCKS=
