# Env of the deploy scripts. Order: DeployTarget, then ConfigureOrigin (on Outbe) and
# ConfigureTarget, then HandOver.

# [required] Deployer private key. The deployer fixes every CREATE3 address.
DEPLOYER_PK=
# [required] CREATE3 factory, deployed once from contracts/shared (mise run deploy-create3-factory there)
CREATE3_FACTORY_ADDRESS=
# [optional] CREATE3 salt; empty selects the pinned production one
CONTRACT_SALT=

# [required] DeployTarget: the ERC-7786 hub (crosschain ERC7786Bridge)
BRIDGE_ADDRESS=
# [required] DeployTarget: auction target chain ids, csv, for the NFT router mesh
TARGET_CHAIN_IDS=
# [required] DeployTarget: the chain id of Outbe
ORIGIN_CHAIN_ID=
# [required] DeployTarget: the wCOEN token bridge, the same CREATE3 address on every chain
WCOEN_BRIDGE=

# [required] ConfigureOrigin: the Outbe precompiles that burn Intex units
INTEX_FACTORY_ADDRESS=0x0000000000000000000000000000000000001015
GEM_FACTORY_ADDRESS=0x0000000000000000000000000000000000002013
# [required] ConfigureTarget: The Compact and the wCOEN token on this chain
COMPACT_ADDRESS=0x00000000000000171ede64904551eeDF3C6C9788
WCOEN_TOKEN=

# [required] HandOver: Outbe chain id, and the Outbe RPC for the Interchain Account of Outbe
OUTBE_CHAIN_ID=
OUTBE_RPC_URL=https://rpc.testnet.outbe.net
