# [required] RPC endpoint
NETWORK=
# [required] Deployer private key. Any key works - the registry's address comes from the pinned salt
# plus WHITELIST_OWNER, not from the deploying account
DEPLOYER_PK=
# [required] Whitelist admin. Part of the registry's address, so keep it identical on every chain
WHITELIST_OWNER=
# [optional] csv of addresses to seed the whitelist with; needs DEPLOYER_PK to be WHITELIST_OWNER
WHITELIST_INITIAL=
# [optional] Uniswap v4 PoolManager; set to deploy the v4 swap gate alongside the whitelist
V4_POOL_MANAGER=
# [optional] PancakeSwap Infinity CLPoolManager; set to deploy the Infinity swap gate
INFINITY_CL_POOL_MANAGER=
