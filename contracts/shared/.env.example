# [required] RPC endpoint
NETWORK=
# [required] Deployer private key. Any key works: the Whitelist admin is the WHITELIST_ADMIN
# constant in src/Whitelist.sol, not the deployer, so the registry's address is the same either way
DEPLOYER_PK=
# [optional] csv of addresses to seed the whitelist with; needs DEPLOYER_PK to be WHITELIST_ADMIN
WHITELIST_INITIAL=
