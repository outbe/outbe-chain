NETWORK=
PRIVATE_KEY=
DEPLOYER_ADDRESS=
ALLOW_EOA_OWNER=false
BRIDGE_ADDRESS=
BNB_VAULT_ROUTER=

# BNB VaultRouter deployment overrides (both optional).
OUTBE_ROUTER=0x0000000000000000000000000000000000001017
ROUTER_OWNER=

# The BSC_* names denote the external side of the route, whichever chain it currently is: point BSC_RPC /
# BSC_CHAIN_ID at BNB testnet or at Sepolia. The scripts hardcode no chain id, so switching networks is an env
# change only. Keep one deployments file per network (e.g. deployments/usdt0.bsc.env, deployments/usdt0.sepolia.env):
# token and bridge addresses differ per chain.
BSC_RPC=https://data-seed-prebsc-2-s1.bnbchain.org:8545
OUTBE_RPC=https://rpc.testnet.outbe.net/
BSC_CHAIN_ID=97
OUTBE_CHAIN_ID=54322345

# Sepolia route (swap into BSC_RPC / BSC_CHAIN_ID to deploy against Sepolia instead of BNB testnet).
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_CHAIN_ID=11155111

# usdt0 route addresses.
BSC_USDT_TOKEN=
BSC_USDT_BRIDGE=
OUTBE_USDT0_TOKEN=
OUTBE_USDT0_BRIDGE=

# wcoen route addresses.
OUTBE_WCOEN_TOKEN=
OUTBE_WCOEN_BRIDGE=
BSC_WCOEN_TOKEN=
BSC_WCOEN_BRIDGE=
