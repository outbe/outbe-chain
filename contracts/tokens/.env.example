NETWORK=
PRIVATE_KEY=
DEPLOYER_ADDRESS=
OWNER_ADDRESS=
ALLOW_EOA_OWNER=false
BRIDGE_ADDRESS=
BNB_VAULT_ROUTER=

# BNB VaultRouter deployment overrides (both optional).
OUTBE_ROUTER=0x0000000000000000000000000000000000001017
ROUTER_OWNER=

# Every route runs between Outbe and one external EVM chain. `OUTBE_*` is always Outbe; `EXTERNAL_*` is whichever
# external chain this deployment targets — BNB testnet, Sepolia, anvil. No chain id and no network name is hardcoded
# in the scripts, so pointing a route at another network is an env change only.
EXTERNAL_RPC=https://data-seed-prebsc-2-s1.bnbchain.org:8545
EXTERNAL_CHAIN_ID=97
OUTBE_RPC=https://rpc.testnet.outbe.net/
OUTBE_CHAIN_ID=54322345

# Sepolia values, to swap into EXTERNAL_RPC / EXTERNAL_CHAIN_ID.
# EXTERNAL_RPC=https://ethereum-sepolia-rpc.publicnode.com
# EXTERNAL_CHAIN_ID=11155111

# Token and bridge addresses differ per external chain, so keep one file per network — e.g.
# deployments/usdt0.bsc.env, deployments/usdt0.sepolia.env — and source the one you are deploying against.

# usdt0 route: canonical USDT on the external chain <> ERC-7802 synthetic on Outbe.
EXTERNAL_USDT_TOKEN=
EXTERNAL_USDT_BRIDGE=
OUTBE_USDT_TOKEN=
OUTBE_USDT_BRIDGE=

# wcoen route: canonical WCOEN on Outbe <> ERC-7802 synthetic on the external chain.
OUTBE_WCOEN_TOKEN=
OUTBE_WCOEN_BRIDGE=
EXTERNAL_WCOEN_TOKEN=
EXTERNAL_WCOEN_BRIDGE=
