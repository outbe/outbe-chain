# [required] Outbe RPC alias or URL
NETWORK=outbe-testnet
# [required] Deployer private key
DEPLOYER_PK=
# [required] Protocol-wide CREATE3 factory
CREATE3_FACTORY_ADDRESS=
# [required] Expected Outbe chain id
OUTBE_CHAIN_ID=
# [required] Comma-separated Safe owner addresses
SAFE_OWNERS=
# [required] Number of owner signatures required for a transaction
SAFE_THRESHOLD=
