# [required] Outbe RPC alias or URL
NETWORK=outbe-testnet
# [required] Deployer private key
DEPLOYER_PK=
# [required] Protocol-wide CREATE3 factory
CREATE3_FACTORY_ADDRESS=
# [required] Expected Outbe chain id
OUTBE_CHAIN_ID=
# [required for create-wallet] SafeL2 singleton from the deploy output
SAFE_SINGLETON=
# [required for create-wallet] SafeProxyFactory from the deploy output
SAFE_PROXY_FACTORY=
# [required for create-wallet] CompatibilityFallbackHandler from the deploy output
SAFE_FALLBACK_HANDLER=
# [required] Comma-separated Safe owner addresses
SAFE_OWNERS=
# [required] Number of owner signatures required for a transaction
SAFE_THRESHOLD=
# [optional] Allows creating another wallet with the same owners and threshold
SAFE_NONCE=0
