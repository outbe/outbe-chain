# TEE enclave sidecar unit (TEMPLATE — adjust paths/env per host, then enable
# alongside outbe-validator.service; the node fail-fasts without the enclave
# socket, so order the enclave Before= the validator).
#
# Logging: stdout/stderr go to journald (rotated by journald's own policy).
# The enclave emits one line per served request
# (`outbe-tee-enclave: req=... peer=... outcome=... dur_ms=... ts=...`) plus
# startup banners — keep them; they are the primary post-incident evidence
# (the 2026-08-22 slowdown was undiagnosable because no enclave output was
# persisted).
#
# Restart policy: `Restart=on-failure` is safe ONLY with a persistent
# `--tee-dir` (sealed offer key restart fast-path). An auto-restarted enclave
# without its sealed state comes back keyless and turns a loud dead-socket
# failure into a quiet decrypt-failure mode. The node reconnects to a restarted
# enclave automatically (session reconnect + identity re-validation) — a node
# restart is NOT required.
#
# Host-side memory inspection (EPC-backing RSS of the gramine loader):
#   systemctl show --property MainPID outbe-tee-enclave
#   grep VmRSS /proc/<MainPID>/status
[Unit]
Description=Outbe TEE Enclave Sidecar (Gramine SGX)
After=network-online.target
Wants=network-online.target
Before=outbe-validator.service
PartOf=outbe-validator-stack.target

[Service]
Type=simple
User=outbe
Group=outbe
EnvironmentFile=/etc/outbe-chain/outbe-tee-enclave.env
# Release bundle launcher (scripts/release/build-sgx-bundle-in-container.sh
# installs it as /opt/outbe/sgx/bin/outbe-tee-enclave-launch).
ExecStart=/opt/outbe/sgx/bin/outbe-tee-enclave-launch \
    --socket ${TEE_ENDPOINT} \
    --tee-dir ${TEE_DIR} \
    --chain-id ${TEE_CHAIN_ID}
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

# Hardening. SGX device access is required; keep the filesystem surface small.
ProtectHome=true
ReadWritePaths=${TEE_DIR}
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
