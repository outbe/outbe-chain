# Runtime-pinned local control identity. OCM-26 writes the final genesis and
# bundle values; these placeholders must not be installed unchanged.
OCOMP_CHAIN_ID=<devnet-chain-id>
OCOMP_GENESIS_HASH=<0x-final-genesis-hash>
OCOMP_BOOT_NONCE=<0x-runtime-boot-nonce>
OCOMP_PROTOCOL_BUNDLE_HASH=<0x-final-protocol-bundle-hash>
OCOMP_REGISTRY_GENERATION=<non-zero-worker-registry-generation>
OCOMP_SUPERVISOR_ADDRESS=127.0.0.1:9765

# One canonical deployment layout. Both fixed services consume finalized
# chain data from public RPC; there are no node-facing local control sockets.
OUTBE_OCOMP_BASE_PATH=/opt/outbe-chain
OUTBE_OCOMP_RPC_URL=http://127.0.0.1:8545
