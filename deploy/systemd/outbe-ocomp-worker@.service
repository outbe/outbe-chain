[Unit]
Description=Outbe OCOMP one-unit worker instance
After=outbe-ocomp-worker.socket

[Service]
Type=simple
User=outbe-ocomp-worker
Group=outbe-ocomp-worker
EnvironmentFile=/etc/outbe/outbe-ocomp.env
ExecStart=/usr/local/bin/outbe-ocomp worker --chain-id ${OCOMP_CHAIN_ID} --genesis-hash ${OCOMP_GENESIS_HASH} --boot-nonce ${OCOMP_BOOT_NONCE} --protocol-bundle-hash ${OCOMP_PROTOCOL_BUNDLE_HASH} --session-generation ${OCOMP_SESSION_GENERATION}
StandardInput=socket
StandardOutput=journal
StandardError=journal
Restart=no
Slice=outbe-ocomp.slice
RuntimeMaxSec=600
MemoryHigh=1536M
MemoryMax=2G
TasksMax=16
IOWeight=100
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
BindReadOnlyPaths=/var/lib/outbe-ocomp/cas-v1/objects
ReadWritePaths=/var/lib/outbe-ocomp/worker-inbox-v1
