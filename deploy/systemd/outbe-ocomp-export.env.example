# Snapshot-exporter-only credentials for its finalized receipt projection.
# This database must be distinct from the node projection database because
# every projector acquires an exclusive writer lease.
OUTBE_OCOMP_PROJECTION_MONGODB_URI=<mongodb://projection-writer@host/outbe>
OUTBE_OCOMP_PROJECTION_MONGODB_DATABASE=<outbe-ocomp-projection-database>
