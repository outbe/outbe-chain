[Unit]
Description=Outbe OCOMP finalized snapshot exporter
After=outbe-validator.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=outbe-ocomp-export
Group=outbe-ocomp-export
ExecStart=/usr/local/bin/outbe-ocomp snapshot-exporter
Restart=on-failure
RestartSec=5
Slice=outbe-ocomp.slice
RuntimeMaxSec=3600
MemoryHigh=1536M
MemoryMax=2G
TasksMax=16
IOWeight=100
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/var/lib/outbe/ce
ReadWritePaths=/var/lib/outbe-ocomp/cas-v1/objects
ReadWritePaths=/var/lib/outbe-ocomp/cas-v1/staging/exporter
ReadWritePaths=/var/lib/outbe-ocomp/exporter-v1

[Install]
WantedBy=outbe-ocomp.target
