[Unit]
Description=Outbe OCOMP finalized snapshot exporter
After=outbe-validator.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=outbe-ocomp-export
Group=outbe-ocomp-artifacts
UMask=0027
EnvironmentFile=/opt/outbe-chain/ocomp.env
EnvironmentFile=/opt/outbe-chain/ocomp-export.env
ExecStart=/opt/outbe-chain/outbe-ocomp snapshot-exporter
Restart=on-failure
RestartSec=5
Slice=outbe-ocomp.slice
RuntimeMaxSec=3600
MemoryHigh=1536M
MemoryMax=2G
TasksMax=16
IOWeight=100
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/opt/outbe-chain/ocomp/ce
ReadWritePaths=/opt/outbe-chain/ocomp/data/cas-v1/objects
ReadWritePaths=/opt/outbe-chain/ocomp/data/cas-v1/staging/exporter
ReadWritePaths=/opt/outbe-chain/ocomp/data/exporter-v1

[Install]
WantedBy=outbe-ocomp.target
