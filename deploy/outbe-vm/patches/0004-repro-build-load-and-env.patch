From: outbe-vm-dev <dev@outbe.network>
Subject: [PATCH 4/4] Load buildx image and allow configurable tag and cpuset

Pass `--load` to `docker build` so `docker-container` BuildKit drivers
load the helper image into the local Docker daemon before `docker run`,
allow overriding the helper image tag via `DSTACK_MKOSI_IMAGE`, and
support optional `--cpuset-cpus` via `DOCKER_CPUSET_CPUS`.

--- a/os/mkosi/repro-build/repro-build.sh
+++ b/os/mkosi/repro-build/repro-build.sh
@@ -44,7 +44,7 @@
 BUILD_DIR=${BUILD_DIR:-$THIS_DIR/build}
 
 DOCKER=${DOCKER:-docker}
-IMAGE=dstack-mkosi-build
+IMAGE=${DSTACK_MKOSI_IMAGE:-dstack-mkosi-build}
 
 # The pin comes from the tree being built, not from this script, so a checkout
 # always gets the mkosi its own sources were tested against.
@@ -92,7 +92,7 @@
 ctx=$(mktemp -d)
 trap 'rm -rf "$ctx"' EXIT
 cp "$THIS_DIR/entrypoint.sh" "$ctx/entrypoint.sh"
-"$DOCKER" build --platform linux/amd64 -t "$IMAGE" \
+"$DOCKER" build --load --platform linux/amd64 -t "$IMAGE" \
     --build-arg "MKOSI_REVISION=$MKOSI_REVISION" \
     --build-arg "MKOSI_VERSION=$MKOSI_VERSION" \
     -f "$THIS_DIR/Dockerfile.repro" "$ctx"
@@ -105,6 +105,7 @@
 # environment rather than writing to the caller's git config.
 "$DOCKER" run --rm --platform linux/amd64 \
     --privileged \
+    ${DOCKER_CPUSET_CPUS:+--cpuset-cpus="$DOCKER_CPUSET_CPUS"} \
     -v /dev:/dev \
     -v "$REPO_ROOT:$REPO_ROOT" \
     -v "$BUILD_DIR:$BUILD_DIR" \
